PORT=8080
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
FIREBASE_PROJECT_ID=
# JSON service-account credential: set as a server secret, never commit.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional; enforce once Android Firebase App Check is configured.
REQUIRE_APP_CHECK=false
FREE_DAILY_SESSIONS=3
ADMOB_REWARDED_AD_UNIT=

# Public Android Firebase configuration, returned by /config (never service-account credentials).
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_APP_ID=
